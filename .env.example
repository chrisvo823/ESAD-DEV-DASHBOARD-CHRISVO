# Firebase web app config (Project settings → Your apps → Web app)
# Either set individual NEXT_PUBLIC_FIREBASE_* vars, or one JSON blob:
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"....firebaseapp.com","projectId":"...","appId":"...","messagingSenderId":"...","storageBucket":"....appspot.com"}
#
# Firebase App Hosting also auto-injects FIREBASE_WEBAPP_CONFIG at BUILD when
# the backend is linked to a web app. next.config.mjs maps it to NEXT_PUBLIC_*.
# FIREBASE_WEBAPP_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Only Google accounts on this domain can open the dashboard
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=machindustries.com

# Live Smartsheet Current/Next Task % Complete (server-only).
# OpenAI Sites: set as a Site secret (mirrored onto process.env by worker/index.ts).
# Firebase App Hosting: set via `firebase apphosting:secrets:set SMARTSHEET_ACCESS_TOKEN`
# (referenced from apphosting.yaml) or App Hosting → Settings → Environment.
# SMARTSHEET_ACCESS_TOKEN=

# Shared Card Configuration Google Doc (Admin Drive → ESAD_Cards_Config).
# Used when host cardConfigDocumentIds are empty after ephemeral FS loss.
# CARD_CONFIG_GOOGLE_DOC_ID=1F016o0deQemL7Feo5QTZQl1VLgKOuiL5VQzwnM8JVj8

# Shared Dashboard Configuration Google Doc + Admin Drive folder access
# Admin Load Config lists/loads Docs from:
# https://drive.google.com/drive/u/0/folders/1g-pGEPe4f2sFmX0sngp-4Pm75ONGMnks
# and the shared Dashboard Configuration Doc:
# https://docs.google.com/document/d/15XbbNYYGVMyxCgQs6MaQAO-cMLJTyRcF_67F0dmc-vA/edit
#
# Preferred: service account JSON with Drive readonly + Docs access.
# Share BOTH the Doc and the Admin Drive folder with the service-account email
# (Viewer is enough to list/load; Editor is required to save Dashboard Configuration).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
#
# Or a short-lived OAuth access token with Docs + Drive scopes:
# GOOGLE_DOCS_ACCESS_TOKEN=
#
# Without server credentials, Admin Load Config opens a Google Drive login popup
# (Firebase Google sign-in with Docs/Drive scopes).
